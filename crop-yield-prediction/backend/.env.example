# Copy to .env and fill in your own values. Never commit .env.
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=crop_app
DB_PASSWORD=change-me
DB_NAME=crop_yield_db

# Origin of the React dev server (CORS is restricted to this origin)
FRONTEND_ORIGIN=http://localhost:5173

# Paths are relative to the backend/ folder
MODEL_PATH=../ml/crop_yield_model.joblib
MODEL_METADATA_PATH=../ml/model_metadata.json

# Create tables on startup if they do not exist (schema.sql is the reference schema)
AUTO_CREATE_TABLES=true
